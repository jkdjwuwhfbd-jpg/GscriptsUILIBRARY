local lib = {}
lib.__index = lib

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local gui = Instance.new("ScreenGui")
gui.Name = "gscripts"
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 999
gui.IgnoreGuiInset = true

if syn and syn.protect_gui then
	syn.protect_gui(gui)
	gui.Parent = game.CoreGui
elseif gethui then
	gui.Parent = gethui()
else
	gui.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local function tw(obj, props, t)
	TweenService:Create(obj, TweenInfo.new(t or 0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

local function isPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch
end

local function isMoved(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch
end

local function makeDraggable(frame, grip)
	local down = false
	local startMouse, startPos

	grip.InputBegan:Connect(function(i)
		if isPress(i) then
			down = true
			startMouse = i.Position
			startPos = frame.Position
		end
	end)

	UserInputService.InputChanged:Connect(function(i)
		if down and isMoved(i) then
			local d = i.Position - startMouse
			frame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + d.X,
				startPos.Y.Scale,
				startPos.Y.Offset + d.Y
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(i)
		if isPress(i) then
			down = false
		end
	end)
end

function lib.new(name)
	local self = setmetatable({}, lib)
	self._y = 8
	self._height = 0

	local win = Instance.new("Frame")
	win.Size = UDim2.new(0, 300, 0, 52)
	win.Position = UDim2.new(0.04, 0, 0.06, 0)
	win.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	win.BorderSizePixel = 0
	win.ClipsDescendants = true
	win.Parent = gui

	local topbar = Instance.new("Frame")
	topbar.Size = UDim2.new(1, 0, 0, 52)
	topbar.BackgroundColor3 = Color3.fromRGB(8, 8, 8)
	topbar.BorderSizePixel = 0
	topbar.ZIndex = 3
	topbar.Parent = win

	local titleLabel = Instance.new("TextLabel")
	titleLabel.Size = UDim2.new(1, -20, 1, 0)
	titleLabel.Position = UDim2.new(0, 14, 0, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = name or "gscripts"
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.TextSize = 16
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextXAlignment = Enum.TextXAlignment.Left
	titleLabel.ZIndex = 4
	titleLabel.Parent = topbar

	local divider = Instance.new("Frame")
	divider.Size = UDim2.new(1, 0, 0, 1)
	divider.Position = UDim2.new(0, 0, 1, -1)
	divider.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	divider.BorderSizePixel = 0
	divider.ZIndex = 4
	divider.Parent = topbar

	local body = Instance.new("Frame")
	body.Name = "body"
	body.Size = UDim2.new(1, 0, 1, -52)
	body.Position = UDim2.new(0, 0, 0, 52)
	body.BackgroundTransparency = 1
	body.Parent = win

	self.win = win
	self.body = body

	makeDraggable(win, topbar)

	return self
end

function lib:_sync()
	self._height = self._y + 10
	self.win.Size = UDim2.new(0, 300, 0, 52 + self._height)
end

function lib:Button(text, fn)
	local y = self._y
	self._y = self._y + 48

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 40)
	btn.Position = UDim2.new(0, 10, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 14
	btn.Font = Enum.Font.Gotham
	btn.AutoButtonColor = false
	btn.Parent = self.body

	btn.MouseEnter:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(28, 28, 28)}, 0.12)
	end)

	btn.MouseLeave:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(16, 16, 16)}, 0.12)
	end)

	local function press()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(38, 38, 38)}, 0.06)
		task.delay(0.14, function()
			tw(btn, {BackgroundColor3 = Color3.fromRGB(16, 16, 16)}, 0.14)
		end)
		if fn then task.spawn(fn) end
	end

	btn.MouseButton1Click:Connect(press)
	btn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then press() end
	end)

	self:_sync()
	return btn
end

function lib:Toggle(text, default, fn)
	local y = self._y
	self._y = self._y + 48
	local state = default == true

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -20, 0, 40)
	row.Position = UDim2.new(0, 10, 0, y)
	row.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
	row.BorderSizePixel = 0
	row.Parent = self.body

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -60, 1, 0)
	lbl.Position = UDim2.new(0, 14, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.TextSize = 14
	lbl.Font = Enum.Font.Gotham
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0, 38, 0, 21)
	track.Position = UDim2.new(1, -50, 0.5, -10)
	track.BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(48, 48, 48)
	track.BorderSizePixel = 0
	track.Parent = row

	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 15, 0, 15)
	knob.Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
	knob.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	knob.BorderSizePixel = 0
	knob.Parent = track

	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Parent = row

	local function toggle()
		state = not state
		tw(track, {BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(48, 48, 48)}, 0.18)
		tw(knob, {Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.18)
		if fn then fn(state) end
	end

	hit.MouseButton1Click:Connect(toggle)
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then toggle() end
	end)

	self:_sync()
	return {
		Set = function(v)
			state = v
			tw(track, {BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(48, 48, 48)}, 0.18)
			tw(knob, {Position = state and UDim2.new(1, -18, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.18)
		end,
		Get = function() return state end
	}
end

function lib:Slider(text, min, max, default, fn)
	local y = self._y
	self._y = self._y + 62
	local val = math.clamp(default or min, min, max)

	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, -20, 0, 54)
	wrap.Position = UDim2.new(0, 10, 0, y)
	wrap.BackgroundColor3 = Color3.fromRGB(16, 16, 16)
	wrap.BorderSizePixel = 0
	wrap.Parent = self.body

	local slbl = Instance.new("TextLabel")
	slbl.Size = UDim2.new(0.65, 0, 0, 28)
	slbl.Position = UDim2.new(0, 14, 0, 0)
	slbl.BackgroundTransparency = 1
	slbl.Text = text
	slbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	slbl.TextSize = 14
	slbl.Font = Enum.Font.Gotham
	slbl.TextXAlignment = Enum.TextXAlignment.Left
	slbl.Parent = wrap

	local vlbl = Instance.new("TextLabel")
	vlbl.Size = UDim2.new(0.35, -14, 0, 28)
	vlbl.Position = UDim2.new(0.65, 0, 0, 0)
	vlbl.BackgroundTransparency = 1
	vlbl.Text = tostring(val)
	vlbl.TextColor3 = Color3.fromRGB(170, 170, 170)
	vlbl.TextSize = 13
	vlbl.Font = Enum.Font.GothamBold
	vlbl.TextXAlignment = Enum.TextXAlignment.Right
	vlbl.Parent = wrap

	local rail = Instance.new("Frame")
	rail.Size = UDim2.new(1, -28, 0, 4)
	rail.Position = UDim2.new(0, 14, 0, 38)
	rail.BackgroundColor3 = Color3.fromRGB(48, 48, 48)
	rail.BorderSizePixel = 0
	rail.Parent = wrap

	local pct = (val - min) / (max - min)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(pct, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	fill.BorderSizePixel = 0
	fill.Parent = rail

	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 13, 0, 13)
	dot.Position = UDim2.new(pct, -6, 0.5, -6)
	dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	dot.BorderSizePixel = 0
	dot.Parent = rail

	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	local sliding = false

	local function apply(pos)
		local rel = math.clamp((pos.X - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1)
		val = math.floor(min + (max - min) * rel)
		vlbl.Text = tostring(val)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		dot.Position = UDim2.new(rel, -6, 0.5, -6)
		if fn then fn(val) end
	end

	rail.InputBegan:Connect(function(i)
		if isPress(i) then sliding = true apply(i.Position) end
	end)
	dot.InputBegan:Connect(function(i)
		if isPress(i) then sliding = true end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if sliding and isMoved(i) then apply(i.Position) end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if isPress(i) then sliding = false end
	end)

	self:_sync()
	return {
		Set = function(v)
			val = math.clamp(v, min, max)
			local r = (val - min) / (max - min)
			vlbl.Text = tostring(val)
			fill.Size = UDim2.new(r, 0, 1, 0)
			dot.Position = UDim2.new(r, -6, 0.5, -6)
		end,
		Get = function() return val end
	}
end

