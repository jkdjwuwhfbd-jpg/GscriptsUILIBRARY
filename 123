function lib:_sync()
	self._height = self._y + 10
	self.win.Size = UDim2.new(0, 260, 0, 46 + self._height)
end

function lib:Button(text, fn)
	local y = self._y
	self._y = self._y + 42

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(1, -20, 0, 34)
	btn.Position = UDim2.new(0, 10, 0, y)
	btn.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 13
	btn.Font = Enum.Font.Gotham
	btn.AutoButtonColor = false
	btn.Parent = self.body

	local side = Instance.new("Frame")
	side.Size = UDim2.new(0, 2, 0.6, 0)
	side.Position = UDim2.new(0, 0, 0.2, 0)
	side.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	side.BackgroundTransparency = 1
	side.BorderSizePixel = 0
	side.Parent = btn

	btn.MouseEnter:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(24, 24, 24)}, 0.12)
		tw(side, {BackgroundTransparency = 0}, 0.12)
	end)

	btn.MouseLeave:Connect(function()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(14, 14, 14)}, 0.12)
		tw(side, {BackgroundTransparency = 1}, 0.12)
	end)

	local function press()
		tw(btn, {BackgroundColor3 = Color3.fromRGB(32, 32, 32)}, 0.06)
		task.delay(0.12, function()
			tw(btn, {BackgroundColor3 = Color3.fromRGB(14, 14, 14)}, 0.12)
			tw(side, {BackgroundTransparency = 1}, 0.12)
		end)
		if fn then task.spawn(fn) end
	end

	btn.MouseButton1Click:Connect(press)
	btn.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then press() end
	end)

	self:_sync()
	return btn
end

function lib:Toggle(text, default, fn)
	local y = self._y
	self._y = self._y + 42
	local state = default == true

	local row = Instance.new("Frame")
	row.Size = UDim2.new(1, -20, 0, 34)
	row.Position = UDim2.new(0, 10, 0, y)
	row.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
	row.BorderSizePixel = 0
	row.Parent = self.body

	local side = Instance.new("Frame")
	side.Size = UDim2.new(0, 2, 0.6, 0)
	side.Position = UDim2.new(0, 0, 0.2, 0)
	side.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	side.BackgroundTransparency = state and 0 or 1
	side.BorderSizePixel = 0
	side.Parent = row

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -52, 1, 0)
	lbl.Position = UDim2.new(0, 12, 0, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	lbl.TextSize = 13
	lbl.Font = Enum.Font.Gotham
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.Parent = row

	local track = Instance.new("Frame")
	track.Size = UDim2.new(0, 36, 0, 20)
	track.Position = UDim2.new(1, -44, 0.5, -10)
	track.BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(45, 45, 45)
	track.BorderSizePixel = 0
	track.Parent = row

	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local knob = Instance.new("Frame")
	knob.Size = UDim2.new(0, 13, 0, 13)
	knob.Position = state and UDim2.new(1, -16, 0.5, -6.5) or UDim2.new(0, 3, 0.5, -6.5)
	knob.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	knob.BorderSizePixel = 0
	knob.Parent = track

	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local hit = Instance.new("TextButton")
	hit.Size = UDim2.new(1, 0, 1, 0)
	hit.BackgroundTransparency = 1
	hit.Text = ""
	hit.Parent = row

	local function toggle()
		state = not state
		tw(track, {BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(45, 45, 45)}, 0.18)
		tw(knob, {Position = state and UDim2.new(1, -16, 0.5, -6.5) or UDim2.new(0, 3, 0.5, -6.5)}, 0.18)
		tw(side, {BackgroundTransparency = state and 0 or 1}, 0.18)
		if fn then fn(state) end
	end

	hit.MouseButton1Click:Connect(toggle)
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.Touch then toggle() end
	end)

	self:_sync()
	return {
		Set = function(v)
			state = v
			tw(track, {BackgroundColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(45, 45, 45)}, 0.18)
			tw(knob, {Position = state and UDim2.new(1, -16, 0.5, -6.5) or UDim2.new(0, 3, 0.5, -6.5)}, 0.18)
			tw(side, {BackgroundTransparency = state and 0 or 1}, 0.18)
		end,
		Get = function() return state end
	}
end

function lib:Slider(text, min, max, default, fn)
	local y = self._y
	self._y = self._y + 54
	local val = math.clamp(default or min, min, max)

	local wrap = Instance.new("Frame")
	wrap.Size = UDim2.new(1, -20, 0, 46)
	wrap.Position = UDim2.new(0, 10, 0, y)
	wrap.BackgroundColor3 = Color3.fromRGB(14, 14, 14)
	wrap.BorderSizePixel = 0
	wrap.Parent = self.body

	local side = Instance.new("Frame")
	side.Size = UDim2.new(0, 2, 0.6, 0)
	side.Position = UDim2.new(0, 0, 0.2, 0)
	side.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	side.BackgroundTransparency = 0
	side.BorderSizePixel = 0
	side.Parent = wrap

	local slbl = Instance.new("TextLabel")
	slbl.Size = UDim2.new(0.65, 0, 0, 24)
	slbl.Position = UDim2.new(0, 12, 0, 0)
	slbl.BackgroundTransparency = 1
	slbl.Text = text
	slbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	slbl.TextSize = 13
	slbl.Font = Enum.Font.Gotham
	slbl.TextXAlignment = Enum.TextXAlignment.Left
	slbl.Parent = wrap

	local vlbl = Instance.new("TextLabel")
	vlbl.Size = UDim2.new(0.35, -12, 0, 24)
	vlbl.Position = UDim2.new(0.65, 0, 0, 0)
	vlbl.BackgroundTransparency = 1
	vlbl.Text = tostring(val)
	vlbl.TextColor3 = Color3.fromRGB(180, 180, 180)
	vlbl.TextSize = 12
	vlbl.Font = Enum.Font.GothamBold
	vlbl.TextXAlignment = Enum.TextXAlignment.Right
	vlbl.Parent = wrap

	local rail = Instance.new("Frame")
	rail.Size = UDim2.new(1, -22, 0, 3)
	rail.Position = UDim2.new(0, 12, 0, 32)
	rail.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
	rail.BorderSizePixel = 0
	rail.Parent = wrap

	local fill = Instance.new("Frame")
	local pct = (val - min) / (max - min)
	fill.Size = UDim2.new(pct, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	fill.BorderSizePixel = 0
	fill.Parent = rail

	local dot = Instance.new("Frame")
	dot.Size = UDim2.new(0, 11, 0, 11)
	dot.Position = UDim2.new(pct, -5, 0.5, -5)
	dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	dot.BorderSizePixel = 0
	dot.Parent = rail

	Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

	local sliding = false

	local function apply(pos)
		local rel = math.clamp((pos.X - rail.AbsolutePosition.X) / rail.AbsoluteSize.X, 0, 1)
		val = math.floor(min + (max - min) * rel)
		vlbl.Text = tostring(val)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		dot.Position = UDim2.new(rel, -5, 0.5, -5)
		if fn then fn(val) end
	end

	rail.InputBegan:Connect(function(i)
		if isPress(i) then sliding = true apply(i.Position) end
	end)
	dot.InputBegan:Connect(function(i)
		if isPress(i) then sliding = true end
	end)
	UserInputService.InputChanged:Connect(function(i)
		if sliding and isMoved(i) then apply(i.Position) end
	end)
	UserInputService.InputEnded:Connect(function(i)
		if isPress(i) then sliding = false end
	end)

	self:_sync()
	return {
		Set = function(v)
			val = math.clamp(v, min, max)
			local r = (val - min) / (max - min)
			vlbl.Text = tostring(val)
			fill.Size = UDim2.new(r, 0, 1, 0)
			dot.Position = UDim2.new(r, -5, 0.5, -5)
		end,
		Get = function() return val end
	}
end

